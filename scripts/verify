#!/usr/bin/env bash
set -euo pipefail

node -e "JSON.parse(require('fs').readFileSync('.claude-plugin/marketplace.json','utf8'))"
node -e "JSON.parse(require('fs').readFileSync('plugins/engineering-os/.claude-plugin/plugin.json','utf8'))"
node skills/engineering-os/scripts/validate_config.mjs engineering-os.json
pnpm exec eslint eslint.config.mjs eslint.format.config.mjs process-guard/scripts skills/engineering-os/scripts test --ext .mjs --config eslint.format.config.mjs
pnpm exec eslint eslint.config.mjs eslint.format.config.mjs process-guard/scripts skills/engineering-os/scripts test --ext .mjs

for file in plugins/engineering-os/agents/*.md plugins/engineering-os/skills/*/SKILL.md; do
  head -1 "${file}" | grep -qx -- '---'
  grep -q '^name:' "${file}"
  grep -q '^description:' "${file}"
done

for file in plugins/engineering-os/prompts/*.md; do
  name="$(basename "${file}")"
  tail -n +2 "${file}" | diff -q - "prompts/${name}"
done

for file in process-guard/scripts/*.mjs; do
  node --check "${file}"
done

node --test test/process-policy.test.mjs
node --test test/engineering-os-config.test.mjs
node --test test/engineering-os-skill.test.mjs
node --test test/acceptance/process-guard/guard.test.mjs

(
  cd test/fixtures/go-project
  ./scripts/verify
)
