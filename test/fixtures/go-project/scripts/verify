#!/usr/bin/env bash
set -euo pipefail

unformatted="$(gofmt -l .)"
if [ -n "${unformatted}" ]; then
  echo "gofmt failed for: ${unformatted}" >&2
  exit 1
fi

go vet ./...
go test ./...
go build ./...

actual="$(go run ./cmd/demo)"
if [ "${actual}" != "engineering-os-go-fixture" ]; then
  echo "entrypoint returned an unexpected result" >&2
  exit 1
fi

printf '%s\n' "${actual}"
